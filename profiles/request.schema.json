{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PrayerTime 0.3 request",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "date",
    "location",
    "timezone"
  ],
  "properties": {
    "date": {
      "type": "string",
      "format": "date",
      "description": "1900-01-01 through 2100-12-31"
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "latitude_deg",
        "longitude_deg"
      ],
      "properties": {
        "latitude_deg": {
          "type": "number",
          "minimum": -90,
          "maximum": 90
        },
        "longitude_deg": {
          "type": "number",
          "minimum": -180,
          "maximum": 180
        }
      }
    },
    "timezone": {
      "type": "string",
      "minLength": 1,
      "description": "IANA identifier in the embedded timezone database"
    },
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "fiqh",
        "calculation"
      ],
      "properties": {
        "fiqh": {
          "enum": [
            "fiqh.shafii@1",
            "fiqh.hanafi_abu_hanifa@1",
            "fiqh.hanafi_sahibayn@1"
          ]
        },
        "calculation": {
          "enum": [
            "calc.mwl@1",
            "calc.isna@1",
            "calc.karachi@1",
            "calc.umm_al_qura@1",
            "calc.egypt@1",
            "calc.gulf@1",
            "calc.kuwait@1",
            "calc.qatar@1",
            "calc.singapore@1",
            "calc.france@1",
            "calc.turkey@1",
            "calc.russia@1",
            "calc.dubai@1",
            "calc.jakim@1",
            "calc.tunisia@1",
            "calc.algeria@1",
            "calc.kemenag@1",
            "calc.morocco@1"
          ]
        }
      }
    },
    "high_latitude": {
      "enum": [
        "none",
        "middle_of_night",
        "one_seventh",
        "angle_based"
      ]
    },
    "rounding": {
      "enum": [
        "nearest_minute",
        "floor_minute",
        "ceil_minute",
        "none"
      ]
    },
    "ramadan": {
      "type": [
        "boolean",
        "null"
      ],
      "description": "Explicit context, required boolean for Umm al-Qura-style method"
    },
    "adjustments_minutes": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fajr": {
          "type": "number",
          "minimum": -120,
          "maximum": 120
        },
        "dhuhr": {
          "type": "number",
          "minimum": -120,
          "maximum": 120
        },
        "asr": {
          "type": "number",
          "minimum": -120,
          "maximum": 120
        },
        "maghrib": {
          "type": "number",
          "minimum": -120,
          "maximum": 120
        },
        "isha": {
          "type": "number",
          "minimum": -120,
          "maximum": 120
        }
      }
    },
    "window_profile": {
      "enum": [
        "none",
        "shafii_draft",
        "hanafi_abu_hanifa_draft",
        "hanafi_sahibayn_draft",
        "maliki_risala_draft",
        "hanbali_umdat_draft",
        "hanbali_third_draft"
      ],
      "default": "none",
      "description": "Optional named draft school account, independent of the timetable Asr convention"
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "profiles"
        ],
        "properties": {
          "profiles": {
            "required": [
              "calculation"
            ],
            "properties": {
              "calculation": {
                "const": "calc.umm_al_qura@1"
              }
            }
          }
        }
      },
      "then": {
        "required": [
          "ramadan"
        ],
        "properties": {
          "ramadan": {
            "type": "boolean"
          }
        }
      }
    }
  ]
}
